---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import { business, services, serviceArea } from '../data/business';

import heroNight from '../assets/photos/hero-night-road.jpg';
import carAtNight from '../assets/photos/car-at-night.jpg';
import carDoor from '../assets/photos/car-door-open.jpg';
import calling from '../assets/photos/calling-for-a-ride.jpg';
import phoneLight from '../assets/photos/phone-in-hand-warm-light.jpg';
import roadCar from '../assets/photos/car-on-road-night.jpg';
import fogCar from '../assets/photos/car-in-fog-dusk.jpg';
import serviceInTown from '../assets/photos/service-in-town.jpg';
import serviceMedical from '../assets/photos/service-medical.jpg';
import serviceNeighbours from '../assets/photos/service-neighbours.jpg';
import serviceFullDay from '../assets/photos/service-full-day.jpg';

const servicePhotos: Record<string, ImageMetadata> = {
  melfort: serviceInTown,
  medical: serviceMedical,
  neighbours: serviceNeighbours,
  'full-day': serviceFullDay,
};

const servicePhotoAlt: Record<string, string> = {
  melfort: 'A black car parked on a street in town.',
  medical: 'A car waiting outside a medical clinic at night.',
  neighbours: 'A car on a country road at sunset.',
  'full-day': 'Luggage being loaded into the back of a car.',
};

const servicePhotoPosition: Record<string, string> = {
  melfort: 'object-[50%_65%]',
  medical: 'object-top',
  neighbours: 'object-[50%_58%]',
  'full-day': 'object-[50%_42%]',
};

/** Each stock photo has its own exposure; these keep the four cards reading as one set. */
const servicePhotoGrade: Record<string, string> = {
  melfort: 'brightness-[0.66] saturate-[0.6]',
  medical: 'brightness-[0.72] saturate-[0.72]',
  neighbours: 'brightness-[0.55] saturate-[0.5]',
  'full-day': 'brightness-[0.7] saturate-[0.62]',
};

const title = 'Stallion Taxi — Taxi Service in Melfort, SK';
const description =
  'Stallion Taxi is a local taxi service in Melfort, Saskatchewan. Rides in town, medical appointments in Prince Albert, Saskatoon and Regina, trips to Kinistino, Tisdale and St. Brieux. Call (306) 920-9896.';

const why = [
  {
    title: 'Local, and it stays local',
    body: 'Stallion Taxi runs out of Melfort — town trips start here and end here.',
  },
  {
    title: 'You talk to a person',
    body: `One number, answered from ${business.hours.opens} to ${business.hours.closes}, seven days a week. No app to install, no account to make.`,
  },
  {
    title: 'Fixed pricing out of town',
    body: 'Trips to Prince Albert, Saskatoon, Regina and the neighbouring towns are quoted at a fixed price by phone — call for a quote.',
  },
  {
    title: 'In town, by the book',
    body: 'Rides within Melfort are charged as set out in the City of Melfort taxi bylaws.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Call or send a request',
    body: `Ring ${business.phoneDisplay}, or fill in the booking form with your pickup, drop-off and time.`,
  },
  {
    n: '02',
    title: 'We confirm your pickup',
    body: 'You get a call or text back to confirm the time, the price for out-of-town trips, and anything you need a hand with.',
  },
  {
    n: '03',
    title: 'Your driver arrives',
    body: 'Meet the car at the address you gave us. If plans change on the way, call and we will sort it out.',
  },
];
---

<BaseLayout title={title} description={description}>
  {/* HERO */}
  <section id="top" class="relative isolate overflow-hidden border-b border-line">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image
        src={heroNight}
        alt=""
        width={2000}
        format="webp"
        quality={62}
        loading="eager"
        fetchpriority="high"
        data-parallax="0.07"
        class="h-full w-full object-cover object-[62%_45%] opacity-70"
      />
      <div class="absolute inset-0 bg-linear-to-r from-ink via-ink/80 to-ink/25"></div>
      <div class="absolute inset-0 bg-linear-to-b from-ink/80 via-ink/5 to-ink"></div>
    </div>

    <div class="shell pt-12 pb-14 sm:pt-16 lg:pt-20 lg:pb-16">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          <p class="eyebrow">{business.tagline}</p>
        </div>

        <h1
          class="display mt-6 text-[2rem] leading-[0.95] font-medium text-bone sm:text-[3.4rem] lg:text-[4.8rem]"
        >
          A ride in Melfort,<br />
          <span class="font-light text-bone/75">when you need one.</span>
        </h1>

        <p class="mt-6 max-w-lg text-base leading-relaxed text-bone/75 sm:text-lg">
          Local taxi service in Melfort, Saskatchewan. Rides across town, medical appointments out
          of town, and trips to the neighbouring towns — seven days a week.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-x-7 gap-y-3">
          <a
            href={business.phoneHref}
            class="inline-flex min-h-11 items-center gap-3 text-gold transition-colors hover:text-gold-light"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path d="M6.6 3.5h2.6l1.4 3.7-2 1.3a12.6 12.6 0 0 0 6.9 6.9l1.3-2 3.7 1.4v2.6a2 2 0 0 1-2.2 2A17.4 17.4 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="text-2xl font-semibold tracking-[-0.01em] sm:text-[1.75rem]">
              {business.phoneDisplay}
            </span>
          </a>
          <p class="text-sm text-mute">
            {business.hours.opens} – {business.hours.closes}, {business.hours.days.toLowerCase()}
          </p>
        </div>
      </div>

      <div class="mt-10 lg:mt-12">
        <BookingForm variant="hero" idPrefix="hero" />
      </div>
    </div>
  </section>

  {/* PHOTO BAND */}
  <section aria-label="Photographs of a taxi ride" class="border-b border-line bg-ink">
    <div class="grid grid-cols-2 gap-px bg-line md:grid-cols-[1.15fr_0.8fr_1fr]">
      <figure class="col-span-2 overflow-hidden bg-ink md:col-span-1" data-reveal>
        <Image
          src={calling}
          data-parallax="0.05"
          alt="A passenger on the phone, arranging a ride."
          width={700}
          format="webp"
          quality={66}
          loading="lazy"
          class="h-64 w-full object-cover object-[50%_25%] brightness-[0.6] saturate-[0.6] sm:h-80 md:h-[23rem]"
        />
      </figure>
      <figure class="overflow-hidden bg-ink" data-reveal>
        <Image
          src={carDoor}
          data-parallax="0.08"
          alt="A driver holding the car door open for a passenger."
          width={700}
          format="webp"
          quality={66}
          loading="lazy"
          class="h-48 w-full object-cover object-[45%_50%] brightness-[0.62] saturate-[0.5] sm:h-80 md:h-[23rem]"
        />
      </figure>
      <figure class="overflow-hidden bg-ink" data-reveal>
        <Image
          src={carAtNight}
          data-parallax="0.07"
          alt="A black car waiting with its headlights on at night."
          width={700}
          format="webp"
          quality={66}
          loading="lazy"
          class="h-48 w-full object-cover object-[50%_45%] brightness-[0.8] saturate-[0.75] sm:h-80 md:h-[23rem]"
        />
      </figure>
    </div>
  </section>

  {/* HOW IT WORKS */}
  <section id="how" class="border-b border-line">
    <div class="shell grid gap-10 py-16 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:py-24">
      <div class="md:sticky md:top-28 md:self-start">
        <div class="section-rule" data-reveal>
          <p class="eyebrow">How it works</p>
          <span class="font-display text-[0.6875rem] tracking-[0.2em] text-mute">01</span>
        </div>
        <h2 class="display mt-6 text-4xl leading-[0.98] font-medium text-bone sm:text-5xl" data-reveal>
          Three steps,<br />no app.
        </h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-mute" data-reveal>
          Book by phone in under a minute. If you send a request from this page, we still call or
          text to lock in the time before the car leaves.
        </p>
      </div>

      <ol class="md:mt-1">
        {
          steps.map((step) => (
            <li class="grid grid-cols-[3.75rem_1fr] gap-x-4 gap-y-2 border-t border-line py-7 first:border-t-0 first:pt-0 sm:grid-cols-[5rem_1fr] sm:gap-x-6" data-reveal>
              <span class="font-display pt-1 text-xs tracking-[0.18em] text-gold/80">STEP {step.n}</span>
              <div>
                <h3 class="text-lg font-semibold text-bone">{step.title}</h3>
                <p class="mt-2 max-w-md text-sm leading-relaxed text-mute">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* SERVICES */}
  <section id="services" class="border-b border-line bg-coal">
    <div class="shell py-16 md:py-24">
      <div class="section-rule" data-reveal>
        <p class="eyebrow">Services</p>
        <span class="font-display text-[0.6875rem] tracking-[0.2em] text-mute">02</span>
      </div>

      <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-10">
        <h2 class="display max-w-xl text-4xl leading-[0.98] font-medium text-bone sm:text-5xl">
          In town, out of town,<br class="hidden sm:block" />
          and out for the day.
        </h2>
        <p class="max-w-sm text-sm leading-relaxed text-mute lg:max-w-xs lg:text-right">
          In-town trips follow the City of Melfort taxi bylaws. Out-of-town trips are fixed-price —
          call for a quote.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:gap-6">
        {
          services.map((service) => (
            <li
              class="group flex flex-col border border-line bg-ink transition-colors duration-300 hover:border-gold/40"
              data-reveal
            >
              <div class="overflow-hidden border-b border-line">
                <Image
                  src={servicePhotos[service.id]}
                  alt={servicePhotoAlt[service.id]}
                  width={900}
                  format="webp"
                  quality={64}
                  loading="lazy"
                  class={`aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04] ${servicePhotoGrade[service.id]} ${servicePhotoPosition[service.id]}`}
                />
              </div>

              <div class="flex flex-1 flex-col p-6 sm:p-7">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="display max-w-[18ch] text-2xl leading-[1.05] font-medium text-bone">
                    {service.title}
                  </h3>
                  <span class="font-display pt-1 text-xs tracking-[0.18em] text-gold/80">
                    {service.index}
                  </span>
                </div>

                <p class="mt-3 text-sm leading-relaxed text-mute">{service.description}</p>
                <p class="mt-3 text-xs leading-relaxed text-mute/75">{service.note}</p>

                <div class="mt-auto pt-6">
                  <a
                    href={business.phoneHref}
                    class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-gold transition-colors hover:text-gold-light"
                  >
                    {service.id === 'melfort' ? 'Call to book' : 'Call for a quote'}
                    <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

    </div>
  </section>

  {/* SERVICE AREA */}
  <section id="area" class="border-b border-line">
    <div class="shell grid gap-10 py-16 md:grid-cols-[1.1fr_1fr] md:gap-14 md:py-24">
      <div>
        <div class="section-rule" data-reveal>
          <p class="eyebrow">Service area</p>
          <span class="font-display text-[0.6875rem] tracking-[0.2em] text-mute">03</span>
        </div>

        <h2 class="display mt-6 max-w-lg text-4xl leading-[0.98] font-medium text-bone sm:text-5xl" data-reveal>
          Melfort first, then the towns that need a ride.
        </h2>

        <dl class="mt-10 space-y-7 border-t border-line pt-7" data-reveal>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">In town</dt>
            <dd class="mt-2 text-base text-bone">{serviceArea.local.join(' · ')}</dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">
              Medical appointments
            </dt>
            <dd class="mt-2 text-base text-bone">{serviceArea.medical.join(' · ')}</dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">
              Neighbouring towns
            </dt>
            <dd class="mt-2 text-base text-bone">{serviceArea.nearby.join(' · ')}</dd>
          </div>
        </dl>

        <p class="mt-8 text-sm leading-relaxed text-mute">
          Coming from another town? Call and we'll confirm your pickup.
        </p>
      </div>

      <figure class="md:pt-2" data-reveal>
        <div class="overflow-hidden border border-line">
          <Image
            src={roadCar}
            alt="A black car with its headlights on, waiting on a dark road at night."
            width={900}
            format="webp"
            quality={68}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover object-[50%_45%] brightness-[0.72] saturate-[0.7] transition-transform duration-700 ease-out hover:scale-[1.04] md:aspect-[4/5]"
          />
        </div>
      </figure>
    </div>
  </section>

  {/* WHY STALLION */}
  <section id="why" class="border-b border-line bg-coal">
    <div class="shell grid gap-10 py-16 md:grid-cols-[0.85fr_1.15fr] md:gap-16 md:py-24">
      <figure class="order-2 md:order-1" data-reveal>
        <div class="relative overflow-hidden border border-line md:sticky md:top-28">
          <Image
            src={fogCar}
            alt="A black sedan with its headlights on in evening fog."
            width={700}
            format="webp"
            quality={68}
            loading="lazy"
            class="aspect-[4/3] w-full object-cover object-[50%_55%] brightness-[0.78] saturate-[0.65] transition-transform duration-700 ease-out hover:scale-[1.04] md:aspect-[3/4]"
          />
        </div>
      </figure>

      <div class="order-1 md:order-2">
        <div class="section-rule" data-reveal>
          <p class="eyebrow">Why Stallion</p>
          <span class="font-display text-[0.6875rem] tracking-[0.2em] text-mute">04</span>
        </div>

        <h2 class="display mt-6 max-w-md text-4xl leading-[0.98] font-medium text-bone sm:text-5xl" data-reveal>
          A clean car, a local driver, a fair price.
        </h2>

        <ul class="mt-10 grid gap-y-7 border-t border-line pt-8 lg:grid-cols-2 lg:gap-x-8">
          {
            why.map((item) => (
              <li data-reveal>
                <h3 class="flex items-start gap-3 text-base font-semibold text-bone">
                  <span class="mt-2.5 h-px w-4 shrink-0 bg-gold" aria-hidden="true" />
                  {item.title}
                </h3>
                <p class="mt-2 pl-7 text-sm leading-relaxed text-mute">{item.body}</p>
              </li>
            ))
          }
        </ul>

      </div>
    </div>
  </section>

  {/* BOOKING / CONTACT */}
  <section id="contact" class="relative isolate overflow-hidden border-b border-line bg-coal">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image
        src={phoneLight}
        alt=""
        width={1200}
        format="webp"
        quality={55}
        loading="lazy"
        data-parallax="0.04"
        class="h-full w-full object-cover object-[65%_35%] opacity-20 md:opacity-30 lg:opacity-40"
      />
      <div class="absolute inset-0 bg-linear-to-r from-ink via-ink/90 to-ink/55"></div>
      <div class="absolute inset-0 bg-linear-to-t from-ink via-transparent to-ink/60"></div>
    </div>

    <div class="shell grid gap-12 py-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 md:py-24">
      <div>
        <div class="section-rule" data-reveal>
          <p class="eyebrow">Book a ride</p>
          <span class="font-display text-[0.6875rem] tracking-[0.2em] text-mute">05</span>
        </div>

        <h2 class="display mt-6 max-w-sm text-4xl leading-[0.98] font-medium text-bone sm:text-5xl" data-reveal>
          Tell us where you are.
        </h2>

        <a
          href={business.phoneHref}
          class="mt-7 inline-flex min-h-11 items-center gap-3 text-gold transition-colors hover:text-gold-light"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M6.6 3.5h2.6l1.4 3.7-2 1.3a12.6 12.6 0 0 0 6.9 6.9l1.3-2 3.7 1.4v2.6a2 2 0 0 1-2.2 2A17.4 17.4 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">
            {business.phoneDisplay}
          </span>
        </a>
        <p class="mt-2 text-sm text-mute">Call for a ride, a quote, or a same-day booking.</p>

        <dl class="mt-9 space-y-5 border-t border-line pt-7 text-sm">
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">Email</dt>
            <dd class="mt-1.5">
              <a href={business.emailHref} class="inline-flex min-h-11 items-center break-words text-bone underline-offset-4 hover:text-gold hover:underline">
                {business.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">Hours</dt>
            <dd class="mt-1.5 text-bone">
              {business.hours.days}, {business.hours.opens} – {business.hours.closes}
            </dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">
              Phone lines open
            </dt>
            <dd class="mt-1.5 text-bone">{business.launch.phoneLinesOpen}</dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">
              First rides
            </dt>
            <dd class="mt-1.5 text-bone">{business.launch.serviceStarts}</dd>
          </div>
          <div>
            <dt class="font-display text-[0.6875rem] font-medium tracking-[0.18em] text-mute uppercase">
              Service area
            </dt>
            <dd class="mt-1.5 text-bone">
              Melfort, plus {serviceArea.medical.join(', ')} for appointments, and{' '}
              {serviceArea.nearby.join(', ')}.
            </dd>
          </div>
        </dl>

        <a
          href={business.facebook}
          rel="noopener"
          class="mt-7 inline-flex h-11 items-center gap-3 text-sm text-bone/80 transition-colors hover:text-gold"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.3 0-1.3-.1-2.45-.1-2.4 0-4.05 1.5-4.05 4.2v2.2H7.4V13h2.8v8h3.3Z"></path>
          </svg>
          Stallion Taxi on Facebook
        </a>
      </div>

      <div id="book" class="scroll-mt-24" data-reveal>
        <BookingForm variant="full" idPrefix="full" />
      </div>
    </div>
  </section>
</BaseLayout>
