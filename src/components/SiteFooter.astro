---
import { business, serviceArea } from '../data/business';

const areaLine = [...serviceArea.local, ...serviceArea.nearby].join(' · ');
const taglineSentence = business.tagline.charAt(0) + business.tagline.slice(1).toLowerCase();

const footerNav = [
  { href: '#how', label: 'How it works' },
  { href: '#services', label: 'Services' },
  { href: '#area', label: 'Service area' },
  { href: '#why', label: 'Why Stallion' },
  { href: '#book', label: 'Book a ride' },
];
---

<footer class="border-t border-line/60 bg-void">
  <div class="shell pt-16 md:pt-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_0.9fr] lg:gap-12">
      <div>
        <img
          src="/logo-stallion-taxi.webp"
          alt="Stallion Taxi"
          width="560"
          height="465"
          class="h-24 w-auto sm:h-28"
          loading="lazy"
        />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-mute">
          Taxi service in Melfort, Saskatchewan. {taglineSentence}.
        </p>
        <a
          href={business.facebook}
          rel="noopener"
          class="mt-4 inline-flex h-11 items-center gap-3 text-sm text-bone/80 transition-colors hover:text-gold"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.3 0-1.3-.1-2.45-.1-2.4 0-4.05 1.5-4.05 4.2v2.2H7.4V13h2.8v8h3.3Z" />
          </svg>
          Find us on Facebook
        </a>
      </div>

      <div>
        <h2 class="eyebrow">Call or email</h2>
        <a
          href={business.phoneHref}
          class="display mt-3 inline-flex min-h-11 items-center text-2xl font-medium text-gold transition-colors hover:text-gold-light sm:text-3xl"
        >
          {business.phoneDisplay}
        </a>
        <a
          href={business.emailHref}
          class="mt-1 flex min-h-11 items-center break-words text-sm text-bone/80 transition-colors hover:text-gold"
        >
          {business.email}
        </a>
        <p class="mt-4 text-sm leading-relaxed text-mute">
          {business.hours.days}<br />
          {business.hours.opens} – {business.hours.closes}
        </p>
      </div>

      <div>
        <h2 class="eyebrow">Service area</h2>
        <p class="mt-3 text-sm leading-relaxed text-bone/80">
          Melfort, plus Prince Albert, Saskatoon and Regina for medical appointments.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-mute">{areaLine}</p>
        <p class="mt-4 text-xs leading-relaxed text-mute">Other towns: call to confirm your pickup.</p>
      </div>
    </div>

    <nav aria-label="Footer" class="mt-12 border-t border-line/50 pt-2">
      <ul class="flex flex-wrap justify-center gap-x-7 gap-y-0">
        {
          footerNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link inline-flex min-h-11 items-center text-sm text-bone/70 transition-colors hover:text-gold"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-6 flex flex-col gap-2 border-t border-line/50 pt-6 pb-10 text-xs text-mute sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Stallion Taxi · Melfort, SK {business.postalCode}</p>
      <p class="tracking-[0.02em]">Taxi service in Melfort, Saskatchewan</p>
    </div>
  </div>

</footer>

