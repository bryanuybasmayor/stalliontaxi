---
import BookingField from './BookingField.astro';
import { business } from '../data/business';

type Props = {
  /** hero = quick request bar, full = the full form in the booking section */
  variant?: 'hero' | 'full';
  /** keeps element ids unique when both forms exist on the page */
  idPrefix: string;
};

const { variant = 'hero', idPrefix } = Astro.props;
const isFull = variant === 'full';
const id = (suffix: string) => `${idPrefix}-${suffix}`;
const passengers = ['1', '2', '3', '4', '5', '6', '7', '8+'];
---

<form
  data-booking-form
  data-variant={variant}
  class={isFull
    ? 'border border-line bg-charcoal/40'
    : 'border border-line bg-ink/85 p-4 backdrop-blur-sm sm:p-6'}
  novalidate
>
  {
    !isFull && (
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="display text-base font-medium tracking-normal text-bone">Request a ride</p>
        <p class="text-xs text-mute">Or call — the phone is the fastest way.</p>
      </div>
    )
  }

  {
    isFull ? (
      <>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line px-5 pt-5 pb-6 sm:px-7">
          <h3 class="display text-lg text-bone">Request a ride</h3>
          <p class="text-xs text-mute">We confirm by call or text</p>
        </div>

        <fieldset class="mt-8 border-0 px-5 sm:px-7">
          <legend class="form-legend eyebrow">Who's riding</legend>
          <div class="grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-12">
            <BookingField
              id={id('name')}
              name="name"
              label="Your name"
              error="Add the name we should ask for."
              autocomplete="name"
              required
              class="col-span-2 sm:col-span-6"
            />
            <BookingField
              id={id('phone')}
              name="phone"
              label="Phone number"
              type="tel"
              placeholder="(306) 000-0000"
              autocomplete="tel"
              error="Enter a phone number we can reach you on."
              required
              class="col-span-2 sm:col-span-6"
            />
          </div>
        </fieldset>

        <fieldset class="mt-7 border-0 px-5 sm:px-7">
          <legend class="form-legend eyebrow">Where and when</legend>
          <div class="grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-12">
            <BookingField
              id={id('pickup')}
              name="pickup"
              label="Pickup"
              placeholder="Address or landmark"
              autocomplete="street-address"
              error="Add a pickup address or landmark."
              required
              class="col-span-2 sm:col-span-6"
            />
            <BookingField
              id={id('dropoff')}
              name="dropoff"
              label="Drop-off"
              placeholder="Where you're going"
              error=""
              class="col-span-2 sm:col-span-6"
            />
            <BookingField
              id={id('date')}
              name="date"
              type="date"
              label="Date"
              error="Choose the date you need the ride."
              required
              class="col-span-2 sm:col-span-6 xl:col-span-4"
            />
            <BookingField
              id={id('time')}
              name="time"
              type="time"
              label="Time"
              error="Choose a pickup time."
              required
              class="col-span-1 sm:col-span-6 xl:col-span-4"
            />
            <BookingField
              id={id('passengers')}
              name="passengers"
              type="select"
              label="Passengers"
              options={passengers}
              error=""
              required
              class="col-span-1 sm:col-span-6 xl:col-span-4"
            />
            <p class="col-span-2 hidden self-end pb-3 text-xs leading-relaxed text-mute/80 sm:col-span-6 sm:block xl:hidden">
              More than 8 people? Call and we'll confirm the vehicle.
            </p>
          </div>
        </fieldset>

        <fieldset class="mt-7 border-0 px-5 sm:px-7">
          <legend class="form-legend eyebrow">Anything else</legend>
          <BookingField
            id={id('notes')}
            name="notes"
            type="textarea"
            label="Notes"
            placeholder="Wheelchair, walker, luggage, child seat, or anything else we should know."
            error=""
          />
        </fieldset>

        <div class="mt-7 border-t border-line px-5 py-6 sm:px-7">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <button type="submit" class="btn-primary w-full sm:w-auto sm:px-8">Request ride</button>
            <a href={business.phoneHref} class="btn-outline w-full sm:w-auto">Call {business.phoneDisplay}</a>
          </div>
          <p class="mt-3 text-xs text-mute">We only use these details to arrange your ride.</p>
        </div>
      </>
    ) : (
      <>
        <div class="grid grid-cols-2 gap-x-3 gap-y-4 lg:grid-cols-12 lg:items-end">
          <BookingField
            id={id('pickup')}
            name="pickup"
            label="Pickup"
            placeholder="Address or landmark"
            autocomplete="street-address"
            error="Add a pickup address or landmark."
            required
            class="col-span-2 lg:col-span-3"
          />
          <BookingField
            id={id('dropoff')}
            name="dropoff"
            label="Drop-off"
            placeholder="Where you're going"
            error=""
            class="col-span-2 lg:col-span-3"
          />
          <BookingField
            id={id('date')}
            name="date"
            type="date"
            label="Date"
            error="Choose the date you need the ride."
            required
            class="col-span-2 sm:col-span-1 lg:col-span-3"
          />
          <BookingField
            id={id('time')}
            name="time"
            type="time"
            label="Time"
            error="Choose a pickup time."
            required
            class="col-span-2 sm:col-span-1 lg:col-span-3"
          />
          <BookingField
            id={id('passengers')}
            name="passengers"
            type="select"
            label="Passengers"
            options={passengers}
            error=""
            required
            class="col-span-2 sm:col-span-1 lg:col-span-3"
          />
          <BookingField
            id={id('phone')}
            name="phone"
            type="tel"
            label="Phone"
            placeholder="(306) 000-0000"
            autocomplete="tel"
            error="Enter a phone number we can reach you on."
            required
            class="col-span-2 sm:col-span-1 lg:col-span-5"
          />
          <div class="col-span-2 flex flex-col gap-2 sm:flex-row lg:col-span-4 lg:col-start-9 lg:self-end">
            <button type="submit" class="btn-primary w-full sm:flex-1">Request ride</button>
            <a href={business.phoneHref} class="btn-outline w-full sm:w-auto">Call {business.phoneDisplay}</a>
          </div>
        </div>

        <p class="mt-3 text-xs leading-relaxed text-mute">
          No account, no app. We call or text you back to confirm.
        </p>
      </>
    )
  }

  <p
    data-form-error
    role="alert"
    class={isFull ? 'mt-4 hidden px-5 pb-5 text-sm text-warn sm:px-7' : 'mt-4 hidden text-sm text-warn'}
  >
    Please check the highlighted fields.
  </p>
</form>

<div
  data-confirmation
  hidden
  class={isFull
    ? 'border border-gold/40 bg-charcoal/60 p-6 sm:p-8'
    : 'border border-gold/40 bg-charcoal/80 p-5 sm:p-6'}
>
  <p class="eyebrow">Request ready to send</p>
  <h3 class="display mt-3 text-2xl leading-tight text-bone sm:text-3xl">
    Send it, and we'll call or text you to confirm.
  </h3>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-mute">
    This site can't send bookings to the office on its own yet. Your email app will open with your
    ride details already filled in — send that message and we'll confirm by phone.
  </p>

  <dl data-summary class="mt-5 grid gap-x-6 gap-y-3 border-t border-line pt-4 text-sm sm:grid-cols-2"></dl>

  <div class="mt-6 flex flex-col gap-2 sm:flex-row">
    <a data-mailto href={business.emailHref} class="btn-primary w-full sm:w-auto">
      Send request by email
    </a>
    <a href={business.phoneHref} class="btn-outline w-full sm:w-auto">Call {business.phoneDisplay}</a>
  </div>

  <button type="button" data-edit class="mt-5 text-xs text-mute underline underline-offset-4 hover:text-gold">
    Change my details
  </button>
</div>
