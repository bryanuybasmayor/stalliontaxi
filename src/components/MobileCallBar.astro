---
import { business } from '../data/business';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-gold/30 bg-ink/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden"
>
  <div class="flex items-center gap-2 px-3 py-2.5">
    <a href={business.phoneHref} class="btn-primary h-12 flex-1 px-4 text-[0.9375rem]">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M6.6 3.5h2.6l1.4 3.7-2 1.3a12.6 12.6 0 0 0 6.9 6.9l1.3-2 3.7 1.4v2.6a2 2 0 0 1-2.2 2A17.4 17.4 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Call {business.phoneDisplay}
    </a>
    <a href="#book" class="btn-outline h-12 shrink-0 px-4 text-[0.9375rem]">Book</a>
  </div>
</div>
