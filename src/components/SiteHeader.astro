---
import { business } from '../data/business';

const nav = [
  { href: '#how', label: 'How it works' },
  { href: '#services', label: 'Services' },
  { href: '#area', label: 'Service area' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/95 backdrop-blur">
  <div class="shell flex h-16 items-center justify-between gap-3 lg:h-20">
    <a href="#top" class="flex min-h-11 shrink-0 items-center gap-3">
      <img
        src="/logo-mark.webp"
        alt=""
        width="360"
        height="252"
        class="h-9 w-auto md:h-11"
        fetchpriority="high"
      />
      <span class="flex flex-col leading-none">
        <span class="font-display text-base font-medium tracking-[0.18em] text-gold md:text-lg">
          STALLION TAXI
        </span>
        <span class="mt-1 text-[0.5625rem] font-medium tracking-[0.2em] text-mute uppercase">
          Melfort, Saskatchewan
        </span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="flex h-11 items-center text-sm text-bone/80 transition-colors hover:text-gold"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href={business.phoneHref}
        class="flex h-11 min-w-11 items-center justify-center gap-2 px-1 text-sm font-semibold text-gold transition-colors hover:text-gold-light sm:min-w-0 sm:justify-start"
      >
        <svg class="h-4 w-4 shrink-0 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6.6 3.5h2.6l1.4 3.7-2 1.3a12.6 12.6 0 0 0 6.9 6.9l1.3-2 3.7 1.4v2.6a2 2 0 0 1-2.2 2A17.4 17.4 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="hidden sm:inline">{business.phoneDisplay}</span>
        <span class="sr-only sm:hidden">Call {business.phoneDisplay}</span>
      </a>

      <a href="#book" class="btn-primary hidden h-11 px-5 sm:inline-flex">Book a Ride</a>

      <button
        type="button"
        id="nav-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-[2px] border border-line text-bone lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Open menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-panel" hidden class="border-t border-line/70 bg-ink lg:hidden">
    <nav aria-label="Mobile" class="shell flex flex-col py-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-line/50 py-4 text-base text-bone last:border-0"
          >
            {item.label}
          </a>
        ))
      }
      <a href="#book" class="btn-primary mt-4 mb-4">Book a Ride</a>
    </nav>
  </div>
</header>
